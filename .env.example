# Copy to .env and fill in local values.

ENVIRONMENT=development

DATABASE_URL=postgresql+psycopg://tourism_pulse:tourism_pulse_dev@localhost:5432/tourism_pulse

# Optional: only needed for `python -m tourism_pulse_api.ingestion.events`.
# Free signup at https://developer.ticketmaster.com/
TICKETMASTER_API_KEY=

# Optional: only needed for `python -m tourism_pulse_api.ingestion.youtube`.
# Enable the YouTube Data API v3 at https://console.cloud.google.com/
YOUTUBE_API_KEY=

# Booking.com/Airbnb have no accessible public API today - these are
# unused placeholders (see ingestion.booking / ingestion.airbnb).
BOOKING_API_KEY=
AIRBNB_API_KEY=